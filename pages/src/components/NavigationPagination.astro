---
import {
  linkMap,
  localeFromUrl,
  navigationForLocale,
  normalizePath,
  pageOrder,
  routeForPage,
} from '../lib/docs-navigation.js';

const { dir } = Astro.locals.starlightRoute;
const isRtl = dir === 'rtl';
const basePath = import.meta.env.BASE_URL.replace(/\/+$/, '');
const locale = localeFromUrl(Astro.url, basePath);
const linksByPath = linkMap(Astro.locals.starlightRoute.sidebar, Astro.url);
const orderedPages = pageOrder(navigationForLocale(locale));
const currentPath = normalizePath(Astro.url.pathname, Astro.url);
const currentIndex = orderedPages.findIndex((page) => routeForPage(page, locale, basePath) === currentPath);

const navigationLink = (page) => page
  ? linksByPath.get(routeForPage(page, locale, basePath))
  : undefined;
const prev = currentIndex > 0 ? navigationLink(orderedPages[currentIndex - 1]) : undefined;
const next = currentIndex >= 0 ? navigationLink(orderedPages[currentIndex + 1]) : undefined;
---

{(prev || next) && (
  <div class="pagination-links print:hidden" dir={dir}>
    {prev && (
      <a href={prev.href} rel="prev">
        <svg viewBox="0 0 24 24" width="1.5rem" height="1.5rem" aria-hidden="true">
          <path d={isRtl ? 'm9 18 6-6-6-6' : 'm15 18-6-6 6-6'} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>
          {Astro.locals.t('page.previousLink')}
          <br />
          <span class="link-title">{prev.label}</span>
        </span>
      </a>
    )}
    {next && (
      <a href={next.href} rel="next">
        <svg viewBox="0 0 24 24" width="1.5rem" height="1.5rem" aria-hidden="true">
          <path d={isRtl ? 'm15 18-6-6 6-6' : 'm9 18 6-6-6-6'} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>
          {Astro.locals.t('page.nextLink')}
          <br />
          <span class="link-title">{next.label}</span>
        </span>
      </a>
    )}
  </div>
)}

<style>
  @layer starlight.core {
    .pagination-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      gap: 1rem;
    }
    a {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.5rem;
      width: 100%;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding: 1rem;
      color: var(--sl-color-gray-2);
      box-shadow: var(--sl-shadow-md);
      overflow-wrap: anywhere;
      text-decoration: none;
    }
    [rel='next'] { justify-content: end; text-align: end; flex-direction: row-reverse; }
    a:hover { border-color: var(--sl-color-gray-2); }
    .link-title { color: var(--sl-color-white); font-size: var(--sl-text-2xl); line-height: var(--sl-line-height-headings); }
    svg { flex-shrink: 0; }
  }
</style>
