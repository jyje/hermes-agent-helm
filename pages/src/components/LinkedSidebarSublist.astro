---
import SidebarRestorePoint from '@astrojs/starlight/components/SidebarRestorePoint.astro';

const { sublist, nested = false } = Astro.props;
const hasCurrentEntry = (entries) => entries.some((entry) =>
  entry.isCurrent || (entry.type === 'group' && hasCurrentEntry(entry.entries)),
);
const isExpanded = (entry) => entry.isCurrent || hasCurrentEntry(entry.entries) || !entry.collapsed;
---

<ul class:list={{ 'top-level': !nested }}>
  {sublist.map((entry) => (
    <li>
      {entry.type === 'link' ? (
        <a
          href={entry.href}
          aria-current={entry.isCurrent ? 'page' : undefined}
          class:list={[{ large: !nested }, entry.attrs.class]}
          {...entry.attrs}
        >
          <span>{entry.label}</span>
          {entry.badge && <span class:list={['sidebar-badge', entry.badge.class]}>{entry.badge.text}</span>}
        </a>
      ) : (
        <details
          open={isExpanded(entry)}
        >
          <summary class:list={{ 'is-current': entry.isCurrent }} tabindex="-1">
            {entry.href ? (
              <a
                class:list={['sidebar-group-link', { large: !nested }]}
                data-sidebar-group-link
                href={entry.href}
                aria-current={entry.isCurrent ? 'page' : undefined}
              >
                <span>{entry.label}</span>
                {entry.badge && <span class:list={['sidebar-badge', entry.badge.class]}>{entry.badge.text}</span>}
              </a>
            ) : (
              <span class="group-label">
                <span class:list={{ large: !nested }}>{entry.label}</span>
                {entry.badge && <span class:list={['sidebar-badge', entry.badge.class]}>{entry.badge.text}</span>}
              </span>
            )}
            <button
              class="sidebar-group-toggle"
              data-sidebar-group-toggle
              type="button"
              aria-label={`Toggle ${entry.label}`}
              aria-expanded={String(isExpanded(entry))}
            >
              <svg class="caret" viewBox="0 0 16 16" width="1.25rem" height="1.25rem" aria-hidden="true">
                <path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </summary>
          <SidebarRestorePoint />
          <Astro.self sublist={entry.entries} nested />
        </details>
      )}
    </li>
  ))}
</ul>

<style>
  @layer starlight.core {
    ul {
      --sl-sidebar-item-padding-inline: 0.5rem;
      list-style: none;
      padding: 0;
    }

    li { overflow-wrap: anywhere; }
    ul ul li { margin-inline-start: var(--sl-sidebar-item-padding-inline); border-inline-start: 1px solid var(--sl-color-hairline-light); padding-inline-start: var(--sl-sidebar-item-padding-inline); }
    .large { font-size: var(--sl-text-lg); font-weight: 600; color: var(--sl-color-white); }
    .top-level > li + li { margin-top: 0.75rem; }
    summary { display: flex; align-items: center; justify-content: flex-start; gap: 0.25rem; padding: 0.2em var(--sl-sidebar-item-padding-inline); line-height: 1.4; cursor: pointer; user-select: none; }
    summary::marker, summary::-webkit-details-marker { display: none; }
    .caret { flex-shrink: 0; transition: transform 0.2s ease-in-out; }
    :global([dir='rtl']) .caret { transform: rotateZ(180deg); }
    [open] > summary .caret { transform: rotateZ(90deg); }
    a { display: block; border-radius: 0.25rem; padding: 0.3em var(--sl-sidebar-item-padding-inline); color: var(--sl-color-gray-2); line-height: 1.4; text-decoration: none; }
    a:hover, a:focus { color: var(--sl-color-white); }
    [aria-current='page'], [aria-current='page']:hover, [aria-current='page']:focus { background-color: var(--sl-color-text-accent); color: var(--sl-color-text-invert); font-weight: 600; }
    .sidebar-group-link { padding: 0; }
    summary.is-current { border-radius: 0.25rem; background-color: var(--sl-color-text-accent); color: var(--sl-color-text-invert); font-weight: 600; }
    summary.is-current > .sidebar-group-link, summary.is-current > .sidebar-group-link:hover, summary.is-current > .sidebar-group-link:focus { background: transparent; color: inherit; }
    .sidebar-group-toggle { display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; margin: -0.15rem 0; border: 0; border-radius: 0.25rem; padding: 0; background: transparent; color: inherit; cursor: pointer; }
    .sidebar-group-toggle:hover, .sidebar-group-toggle:focus-visible { background: color-mix(in srgb, currentColor, transparent 84%); outline: none; }
    .sidebar-group-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; }
    .sidebar-badge { display: inline-flex; align-items: center; border-radius: 0.25rem; padding: 0.1rem 0.35rem; background: var(--sl-color-gray-6); color: var(--sl-color-gray-2); font-size: 0.7em; font-weight: 600; line-height: 1.2; }
    a > *:not(:last-child), .group-label > *:not(:last-child) { margin-inline-end: 0.25em; }

    @media (min-width: 50rem) {
      .top-level > li + li { margin-top: 0.5rem; }
      .large { font-size: var(--sl-text-base); }
      a { font-size: var(--sl-text-sm); }
    }
  }
</style>
