---
import { readdir, readFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import { Code } from '@astrojs/starlight/components';
import RawDocumentActions from './RawDocumentActions.astro';

interface Props {
  /** Directory name below charts/. It must be a single path segment. */
  chart: string;
}

const { chart } = Astro.props;

if (!/^[a-z0-9][a-z0-9-]*$/.test(chart)) {
  throw new Error(`Invalid chart name: ${chart}`);
}

const chartsDirectory = fileURLToPath(new URL('../../../charts/', import.meta.url));
const chartDirectory = fileURLToPath(new URL(`${chart}/`, new URL(chartsDirectory, 'file:')));
const overlayNames = (await readdir(chartDirectory, { withFileTypes: true }))
  .filter((entry) => entry.isFile() && /^values-.+\.ya?ml$/.test(entry.name))
  .map((entry) => entry.name)
  .sort((left, right) => left.localeCompare(right));

const overlays = await Promise.all(overlayNames.map(async (name) => ({
  name,
  source: await readFile(new URL(name, new URL(chartDirectory, 'file:')), 'utf8'),
})));
---

{overlays.map(({ name, source }) => {
  const chartPath = `charts/${chart}/${name}`;
  const rawPath = `${import.meta.env.BASE_URL}/source/${chartPath}`;

  return (
    <section class="values-overlay" aria-labelledby={`overlay-${name}`}>
      <h2 id={`overlay-${name}`}>{name}</h2>
      <RawDocumentActions rawPath={rawPath} label="Open Raw YAML" pageLevel={false} />
      <Code code={source} lang="yaml" meta={`title="${chartPath}"`} />
    </section>
  );
})}
