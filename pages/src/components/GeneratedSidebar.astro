---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import LinkedSidebarSublist from './LinkedSidebarSublist.astro';
import {
  linkMap,
  localeFromUrl,
  navigationForLocale,
  routeForPage,
} from '../lib/docs-navigation.js';

const basePath = import.meta.env.BASE_URL.replace(/\/+$/, '');
const locale = localeFromUrl(Astro.url, basePath);
const linksByPath = linkMap(Astro.locals.starlightRoute.sidebar, Astro.url);

const pageLink = (page) => {
  const route = routeForPage(page, locale, basePath);
  const link = linksByPath.get(route);
  if (!link) throw new Error(`docs/navigation.yml references a missing ${locale} page: ${page}`);
  return link;
};

const buildNavigation = (nodes) => nodes.map((node) => {
  if (typeof node === 'string') return pageLink(node);

  const indexLink = node.page ? pageLink(node.page) : undefined;
  if (!indexLink && !node.label) {
    throw new Error('A navigation group needs either a page or a label.');
  }

  return {
    type: 'group',
    label: indexLink?.label ?? node.label,
    href: indexLink?.href,
    isCurrent: indexLink?.isCurrent,
    badge: indexLink?.badge,
    collapsed: node.collapsed ?? false,
    entries: buildNavigation(node.children ?? []),
  };
});

const localeNavigation = navigationForLocale(locale);
const sidebar = buildNavigation(localeNavigation);
---

<SidebarPersister>
  <LinkedSidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
