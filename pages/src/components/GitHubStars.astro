---
const repository = 'jyje/hermes-agent-helm';
const isInstallPage = Astro.url.pathname.endsWith('/getting-started/install/');
---

<a class="github-stars sl-flex" href={`https://github.com/${repository}`} rel="me" aria-label="GitHub repository">
  <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.44-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 4.77c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z" /></svg>
  <span class="sr-only">GitHub repository</span>
  {isInstallPage && <span class="github-stars__count" data-github-stars aria-live="polite">Stars</span>}
</a>

{isInstallPage && <script define:vars={{ repository }}>
  const count = document.querySelector('[data-github-stars]');
  fetch(`https://api.github.com/repos/${repository}`, { headers: { Accept: 'application/vnd.github+json' } })
    .then((response) => response.ok ? response.json() : Promise.reject(response))
    .then(({ stargazers_count }) => {
      if (typeof stargazers_count === 'number' && count) {
        count.textContent = new Intl.NumberFormat().format(stargazers_count);
      }
    })
    .catch(() => { if (count) count.textContent = 'GitHub'; });
</script>}
