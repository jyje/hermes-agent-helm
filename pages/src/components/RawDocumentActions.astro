---
interface Props {
  rawPath: string;
  label?: string;
  /** Move a page's single source menu directly below its H1. */
  pageLevel?: boolean;
}
const { rawPath, label = 'Open Raw YAML', pageLevel = true } = Astro.props;
---

<div class="raw-document-actions" data-page-source-actions={pageLevel ? '' : undefined} data-raw-path={rawPath}>
  <a href={rawPath}>{label}</a>
  <button type="button" data-copy-source>Copy Source</button>
</div>
