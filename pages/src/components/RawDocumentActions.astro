---
interface Props { rawPath: string; label?: string; }
const { rawPath, label = 'Open Raw YAML' } = Astro.props;
---

<div class="raw-document-actions" data-page-source-actions data-raw-path={rawPath}>
  <a href={rawPath}>{label}</a>
  <button type="button" data-copy-source>Copy Source</button>
</div>
